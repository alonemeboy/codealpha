import matplotlib.pyplot as plt

# Create figure
fig, ax = plt.subplots(figsize=(14, 6))

# Select top 5 regions by total unemployment
top_regions = unemployment_by_region_sum.head(5).index

# Plot time series for each region
for region in top_regions:
    region_data = combined_df[combined_df['Region'] == region].sort_values('Date')
    ax.plot(region_data['Date'], region_data['Estimated Unemployment Rate (%)'],
            marker='o', label=region, linewidth=2)

# Customize plot
ax.set_xlabel('Date', fontsize=12)
ax.set_ylabel('Unemployment Rate (%)', fontsize=12)
ax.set_title('Unemployment Trends Over Time - Top 5 Regions', fontsize=14)
ax.legend(loc='best')
ax.grid(True, alpha=0.3)
plt.xticks(rotation=45)
plt.tight_layout()

# Show plot
plt.show()

